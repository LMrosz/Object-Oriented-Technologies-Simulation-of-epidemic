digraph Lab3 {
  graph [rankdir=TB, fontname="DejaVu Sans", nodesep=0.55, ranksep=0.9, splines=true, pad=0.4, dpi=110, labelloc=t,
         label=<<B>Laboratorium 3 – symulacja zakażeń: diagram klas (wzorce Stan i Pamiątka)</B>>, fontsize=24, newrank=true];
  node  [shape=plain, fontname="DejaVu Sans", fontsize=11];
  edge  [color="#37474F", fontcolor="#37474F"];
  subgraph cluster_lab2 {
    label=<<B>Wektory (Laboratorium 2)</B>>; labeljust="l"; fontsize=15; fontcolor="#546E7A";
    style="filled,rounded"; fillcolor="#F6F8F9"; color="#546E7A"; penwidth=2; margin=14;
    IVector [label=<<TABLE BORDER="2" COLOR="#546E7A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ECEFF1"><TR><TD COLSPAN="2" BGCOLOR="#546E7A" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><I>«interface»</I><BR/><B>IVector</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#607D8B">pole / metoda   ·   opis</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">+abs(): double<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>długość wektora |v|<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+cdot(IVector param): double<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>iloczyn skalarny z innym wektorem<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+getComponents(): double[]<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>składowe wektora {x, y}<BR ALIGN="LEFT"/></I></FONT></TD></TR></TABLE>>];
    IPolar2D [label=<<TABLE BORDER="2" COLOR="#546E7A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ECEFF1"><TR><TD COLSPAN="2" BGCOLOR="#546E7A" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><I>«interface»</I><BR/><B>IPolar2D</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#607D8B">pole / metoda   ·   opis</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">+getAngle(): double<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>kąt między osią OX a wektorem [rad]<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+abs(): double<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>długość wektora (promień we współrzędnych biegunowych)<BR ALIGN="LEFT"/></I></FONT></TD></TR></TABLE>>];
    Vector2D [label=<<TABLE BORDER="2" COLOR="#546E7A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ECEFF1"><TR><TD COLSPAN="2" BGCOLOR="#546E7A" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>Vector2D</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#607D8B">pole / metoda   ·   opis</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">-x: double  {final}<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>składowa X (położenie [m] lub prędkość [m/s])<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-y: double  {final}<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>składowa Y<BR ALIGN="LEFT"/></I></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">+Vector2D(double x, double y)<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>tworzy wektor o podanych składowych<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+abs(): double<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>√(x² + y²)<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+cdot(IVector param): double<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>x·x₂ + y·y₂<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+getComponents(): double[]<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>zwraca kopię {x, y}<BR ALIGN="LEFT"/></I></FONT></TD></TR><HR/><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#FFF9C4"><FONT POINT-SIZE="10">Ruch osobnika: nowa pozycja = new Vector2D(x + vx·dt, y +<BR ALIGN="LEFT"/>vy·dt), składowe z getComponents().<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
    Polar2DAdapter [label=<<TABLE BORDER="2" COLOR="#546E7A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#ECEFF1"><TR><TD COLSPAN="2" BGCOLOR="#546E7A" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><I>«Adapter»</I><BR/><B>Polar2DAdapter</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#607D8B">pole / metoda   ·   opis</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">-srcVector: Vector2D  {final}<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>adaptowany wektor kartezjański<BR ALIGN="LEFT"/></I></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">+Polar2DAdapter(Vector2D src)<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>opakowuje wektor w widok biegunowy<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+getAngle(): double<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>atan2(y, x) – kierunek ruchu<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+abs(): double<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>szybkość = długość wektora prędkości<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+cdot(IVector param): double<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>deleguje do srcVector<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+getComponents(): double[]<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>deleguje do srcVector<BR ALIGN="LEFT"/></I></FONT></TD></TR></TABLE>>];
  }

  subgraph cluster_stan {
    label=<<B>Wzorzec STAN – stan zdrowotny osobnika</B>>; labeljust="l"; fontsize=15; fontcolor="#1565C0";
    style="filled,rounded"; fillcolor="#F2F8FF"; color="#1565C0"; penwidth=2; margin=14;
    StateType [label=<<TABLE BORDER="2" COLOR="#1565C0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#DCEBFF"><TR><TD COLSPAN="2" BGCOLOR="#1565C0" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><I>«enumeration»</I><BR/><B>StateType</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#607D8B">pole / metoda   ·   opis</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">IMMUNE<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>odporny na zakażenie<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">HEALTHY<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>wrażliwy, zdrowy<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">INFECTED_SYMPTOMATIC<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>zakażony, z objawami<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">INFECTED_ASYMPTOMATIC<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>zakażony, bez objawów<BR ALIGN="LEFT"/></I></FONT></TD></TR><HR/><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#FFF9C4"><FONT POINT-SIZE="10">Służy do zapisu stanu w pamiątce – obiektów stanu nie<BR ALIGN="LEFT"/>serializujemy.<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
    HealthState [label=<<TABLE BORDER="2" COLOR="#1565C0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#DCEBFF"><TR><TD COLSPAN="2" BGCOLOR="#1565C0" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><I>«interface – State»</I><BR/><B>HealthState</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#607D8B">pole / metoda   ·   opis</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">+update(Person p): void<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>jeden krok czasu w tym stanie (zakażony odlicza chorobę; po 0<BR ALIGN="LEFT"/>→ ImmuneState)<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+getType(): StateType<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>identyfikator stanu (do pamiątki i do koloru)<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+isSusceptible(): boolean<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>czy osobnik może się zarazić (tylko zdrowy nieodporny)<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+isInfectious(): boolean<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>czy osobnik zaraża innych<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+transmissionProbability(): double<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>szansa zakażenia partnera po 3 s kontaktu: 0,5 / 1,0<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+getRemainingSteps(): int<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>ile kroków choroby zostało (0 poza zakażonymi)<BR ALIGN="LEFT"/></I></FONT></TD></TR></TABLE>>];
    ImmuneState [label=<<TABLE BORDER="2" COLOR="#0D47A1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#BBDEFB"><TR><TD COLSPAN="2" BGCOLOR="#0D47A1" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><I>«ConcreteState»</I><BR/><B>ImmuneState</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#607D8B">pole / metoda   ·   opis</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">+update(Person p): void<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>nic nie robi – stan końcowy<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+isSusceptible(): false<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>nigdy się nie zaraża<BR ALIGN="LEFT"/></I></FONT></TD></TR></TABLE>>];
    HealthyState [label=<<TABLE BORDER="2" COLOR="#0D47A1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#BBDEFB"><TR><TD COLSPAN="2" BGCOLOR="#0D47A1" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><I>«ConcreteState»</I><BR/><B>HealthyState</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#607D8B">pole / metoda   ·   opis</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">+update(Person p): void<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>nic nie robi – zakażenie wywołuje Simulation<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+isSusceptible(): true<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>może się zarazić<BR ALIGN="LEFT"/></I></FONT></TD></TR></TABLE>>];
    InfectedState [label=<<TABLE BORDER="2" COLOR="#1565C0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#DCEBFF"><TR><TD COLSPAN="2" BGCOLOR="#1565C0" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><I>«abstract – ConcreteState»</I><BR/><B>InfectedState</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#607D8B">pole / metoda   ·   opis</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">#remainingSteps: int<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>ile kroków do ozdrowienia (losowo 500–750 = 20–30 s)<BR ALIGN="LEFT"/></I></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">+update(Person p): void<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>remainingSteps--; gdy 0 → p.setState(new ImmuneState())<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+isInfectious(): true<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>zakażony zaraża<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+getRemainingSteps(): int<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>zwraca remainingSteps<BR ALIGN="LEFT"/></I></FONT></TD></TR></TABLE>>];
    SymptomaticState [label=<<TABLE BORDER="2" COLOR="#0D47A1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#BBDEFB"><TR><TD COLSPAN="2" BGCOLOR="#0D47A1" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><I>«ConcreteState»</I><BR/><B>SymptomaticState</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#607D8B">pole / metoda   ·   opis</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">+transmissionProbability(): 1.0<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>od objawowego zakażenie jest pewne (100%)<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+getType(): StateType<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>zwraca INFECTED_SYMPTOMATIC<BR ALIGN="LEFT"/></I></FONT></TD></TR></TABLE>>];
    AsymptomaticState [label=<<TABLE BORDER="2" COLOR="#0D47A1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#BBDEFB"><TR><TD COLSPAN="2" BGCOLOR="#0D47A1" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><I>«ConcreteState»</I><BR/><B>AsymptomaticState</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#607D8B">pole / metoda   ·   opis</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">+transmissionProbability(): 0.5<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>od bezobjawowego zakażenie z szansą 50%<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+getType(): StateType<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>zwraca INFECTED_ASYMPTOMATIC<BR ALIGN="LEFT"/></I></FONT></TD></TR></TABLE>>];
    StateFactory [label=<<TABLE BORDER="2" COLOR="#1565C0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#DCEBFF"><TR><TD COLSPAN="2" BGCOLOR="#1565C0" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><I>«Factory»</I><BR/><B>StateFactory</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#607D8B">pole / metoda   ·   opis</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">+create(StateType t, int remainingSteps): HealthState<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>buduje obiekt stanu z typu – używane przy wczytywaniu pamiątki<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+randomInfected(Random r, SimulationConfig c): InfectedState<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>losuje, czy zakażony ma objawy, oraz czas choroby 500–750<BR ALIGN="LEFT"/>kroków<BR ALIGN="LEFT"/></I></FONT></TD></TR></TABLE>>];
  }

  subgraph cluster_model {
    label=<<B>Model symulacji</B>>; labeljust="l"; fontsize=15; fontcolor="#2E7D32";
    style="filled,rounded"; fillcolor="#F3FBF3"; color="#2E7D32"; penwidth=2; margin=14;
    Person [label=<<TABLE BORDER="2" COLOR="#2E7D32" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#DFF3DF"><TR><TD COLSPAN="2" BGCOLOR="#2E7D32" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><I>«Context»</I><BR/><B>Person</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#607D8B">pole / metoda   ·   opis</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">-id: int<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>unikalny numer osobnika (klucz w ContactTracker, identyfikacja<BR ALIGN="LEFT"/>w pamiątce)<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-position: Vector2D<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>położenie w obszarze [m]<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-velocity: Polar2DAdapter<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>prędkość: kąt kierunku i szybkość (≤ 2,5 m/s)<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-previousPosition: Vector2D<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>położenie sprzed ostatniego ruchu – potrzebne przy zawróceniu<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-state: HealthState<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>bieżący stan zdrowotny (wzorzec Stan)<BR ALIGN="LEFT"/></I></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">+Person(int id, Vector2D position, Polar2DAdapter velocity, HealthState state)<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>tworzy osobnika<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+velocityOf(double angle, double speed): Polar2DAdapter  {static}<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>buduje wektor prędkości z kąta [rad] i szybkości [m/s]<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+update(): void<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>deleguje do state.update(this)<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+move(double dt): void<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>zapamiętuje poprzednie położenie; pozycja += prędkość · dt (dt<BR ALIGN="LEFT"/>= 0,04 s, ≤ 10 cm na krok)<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+randomizeVelocity(Random r, double maxSpeed): void<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>mała losowa zmiana kąta (σ = 0,1 rad) i szybkości (σ = 2%<BR ALIGN="LEFT"/>maxSpeed); szybkość w [0,04·maxSpeed; maxSpeed] = [0,1; 2,5]<BR ALIGN="LEFT"/>m/s<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+turnBack(): void<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>zawraca: kąt + π i powrót na previousPosition (do wnętrza<BR ALIGN="LEFT"/>obszaru)<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+distanceTo(Person o): double<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>odległość euklidesowa √(dx² + dy²) [m] – do sprawdzania<BR ALIGN="LEFT"/>kontaktu ≤ 2 m<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+getId(): int<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>numer osobnika<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+getPosition(): Vector2D<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>odczyt położenia (rysowanie, granice)<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+getVelocity(): Polar2DAdapter<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>odczyt prędkości (zapis do pamiątki)<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+setState(HealthState s) / getState()<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>zmiana i odczyt stanu – przejścia robią same stany<BR ALIGN="LEFT"/></I></FONT></TD></TR></TABLE>>];
    Area [label=<<TABLE BORDER="2" COLOR="#2E7D32" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#DFF3DF"><TR><TD COLSPAN="2" BGCOLOR="#2E7D32" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>Area</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#607D8B">pole / metoda   ·   opis</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">-width: double  {final}<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>szerokość obszaru [m]<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-height: double  {final}<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>wysokość obszaru [m]<BR ALIGN="LEFT"/></I></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">+Area(double width, double height)<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>tworzy obszar; rzuca wyjątek dla wymiarów ≤ 0<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+contains(Vector2D p): boolean<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>czy punkt leży w obszarze (brzeg liczy się jako wnętrze)<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+randomBorderPoint(Random r): Vector2D<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>losowy punkt na obwodzie, równomiernie po długości<BR ALIGN="LEFT"/></I></FONT></TD></TR></TABLE>>];
    ContactTracker [label=<<TABLE BORDER="2" COLOR="#2E7D32" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#DFF3DF"><TR><TD COLSPAN="2" BGCOLOR="#2E7D32" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>ContactTracker</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#607D8B">pole / metoda   ·   opis</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">-contactSteps: Map&lt;Long, Integer&gt;<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>dla każdej pary osobników (klucz z dwóch id): ile kolejnych<BR ALIGN="LEFT"/>kroków w zasięgu ≤ 2 m<BR ALIGN="LEFT"/></I></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">+track(List&lt;Person&gt; persons, double radius): void<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>zwiększa liczniki par w zasięgu, zeruje pozostałe<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+getContactSteps(Person a, Person b): int<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>odczyt licznika pary (próg: 75 kroków = 3 s)<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+reset(Person a, Person b): void<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>zeruje licznik po nieudanej próbie zakażenia<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+snapshot(): List&lt;ContactEntry&gt;<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>kopia liczników do pamiątki<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+restore(List&lt;ContactEntry&gt; e): void<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>odtwarza liczniki z pamiątki<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">~set(int idA, int idB, int steps): void<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>ręczne ustawienie licznika pary<BR ALIGN="LEFT"/></I></FONT></TD></TR></TABLE>>];
    SimulationConfig [label=<<TABLE BORDER="2" COLOR="#2E7D32" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#DFF3DF"><TR><TD COLSPAN="2" BGCOLOR="#2E7D32" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><B>SimulationConfig</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#607D8B">pole / metoda   ·   opis</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">-areaWidth: double<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>szerokość obszaru n [m]<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-areaHeight: double<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>wysokość obszaru m [m]<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-maxSpeed: double<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>górny limit szybkości osobnika: 2,5 m/s<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-stepsPerSecond: int<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>kroków na sekundę symulacji: 25 (dt = 1/25 s)<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-borderExitProb: double<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>szansa opuszczenia obszaru na granicy: 0,5 (w przeciwnym razie<BR ALIGN="LEFT"/>zawraca)<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-entryInfectionProb: double<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>szansa, że wchodzący osobnik jest zakażony: 0,1<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-infectionRadius: double<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>maks. odległość zakażenia: 2 m<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-requiredContactSteps: int<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>czas kontaktu potrzebny do zakażenia: 3 s = 75 kroków<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-infectionMinSteps: int<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>minimalny czas choroby: 20 s = 500 kroków<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-infectionMaxSteps: int<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>maksymalny czas choroby: 30 s = 750 kroków<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-initialPopulation: int<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>początkowa liczebność populacji (dobrana tak, by zachować<BR ALIGN="LEFT"/>ciągłość populacji)<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-spawnRate: double<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>częstotliwość wkraczania nowych osobników – szansa na krok<BR ALIGN="LEFT"/>(dobrana tak, by zachować ciągłość populacji)<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-immuneRatio: double<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>udział odpornych w populacji początkowej i wśród wchodzących:<BR ALIGN="LEFT"/>0 = przypadek 1, &gt; 0 = przypadek 2<BR ALIGN="LEFT"/></I></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">+SimulationConfig()<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>wartości domyślne: 50 × 50 m, 100 osób, spawnRate 0,065,<BR ALIGN="LEFT"/>immuneRatio 0,3<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+SimulationConfig(13 parametrów)<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>konstruktor ustawiający wszystkie pola, z walidacją<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+getXxx() dla każdego pola<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>gettery (brak setterów – obiekt niezmienny)<BR ALIGN="LEFT"/></I></FONT></TD></TR><HR/><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#FFF9C4"><FONT POINT-SIZE="10">Serializable – zapisywana w pamiątce razem ze stanem<BR ALIGN="LEFT"/>symulacji.<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
    Simulation [label=<<TABLE BORDER="2" COLOR="#2E7D32" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#DFF3DF"><TR><TD COLSPAN="2" BGCOLOR="#2E7D32" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><I>«Originator»</I><BR/><B>Simulation</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#607D8B">pole / metoda   ·   opis</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">-persons: List&lt;Person&gt;<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>osobniki aktualnie w obszarze<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-area: Area<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>obszar symulacji<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-config: SimulationConfig<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>parametry scenariusza<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-tracker: ContactTracker<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>liczniki czasu kontaktu<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-random: Random<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>jedyne źródło losowości – daje powtarzalność po wczytaniu<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-stepNumber: int<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>numer kroku; czas t = stepNumber / 25 s<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-nextId: int<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>następny wolny numer osobnika<BR ALIGN="LEFT"/></I></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">+Simulation(SimulationConfig c)<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>nowa symulacja z losową populacją początkową<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+Simulation(SimulationConfig c, long seed)<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>to samo z ustalonym ziarnem – powtarzalny przebieg<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+step(): void<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>jeden krok (0,04 s): ruch → granice → stany (odliczanie<BR ALIGN="LEFT"/>choroby) → kontakty → zakażenia → wejścia<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+getTimeSeconds(): double<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>czas symulacji [s]<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+getStepNumber(): int<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>numer bieżącego kroku<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+getPersons(): List&lt;Person&gt;<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>odczyt dla wizualizacji (lista niemodyfikowalna)<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+getConfig(): SimulationConfig / +getArea(): Area<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>odczyt parametrów i obszaru (rysowanie)<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+count(StateType t): int<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>liczba osobników w danym stanie (pasek statusu)<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">~handleBorders(): void<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>na granicy: 50% zawróć, 50% usuń z obszaru<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">~handleInfections(): void<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>po ≥ 75 krokach kontaktu losuje zakażenie (0,5 / 1,0)<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">~spawnPersons(): void<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>z szansą spawnRate na krok nowy osobnik na brzegu, kierunek do<BR ALIGN="LEFT"/>wnętrza<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-createPerson(Vector2D p, double angle): Person<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>losuje stan: odporny (immuneRatio), zakażony (0,1) albo zdrowy<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-inwardAngle(Vector2D p): double<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>kierunek do wnętrza od najbliższej krawędzi, ±80°<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+createMemento(): SimulationMemento<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>robi migawkę stanu symulacji (Originator)<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+restore(SimulationMemento m): void<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>przywraca stan symulacji z migawki<BR ALIGN="LEFT"/></I></FONT></TD></TR></TABLE>>];
  }

  subgraph cluster_mem {
    label=<<B>Wzorzec PAMIĄTKA – zapis i odczyt stanu symulacji</B>>; labeljust="l"; fontsize=15; fontcolor="#E65100";
    style="filled,rounded"; fillcolor="#FFF8EE"; color="#E65100"; penwidth=2; margin=14;
    SimulationMemento [label=<<TABLE BORDER="2" COLOR="#E65100" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFE8CC"><TR><TD COLSPAN="2" BGCOLOR="#E65100" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><I>«Memento»</I><BR/><B>SimulationMemento</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#607D8B">pole / metoda   ·   opis</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">-stepNumber: int<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>numer kroku w chwili zapisu<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-persons: List&lt;PersonSnapshot&gt;<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>kopie stanu wszystkich osobników<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-contacts: List&lt;ContactEntry&gt;<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>liczniki kontaktów par<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-random: Random<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>kopia generatora – ten sam dalszy przebieg<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-nextId: int<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>następny wolny numer osobnika<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-config: SimulationConfig<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>parametry scenariusza (do zapisu w pliku)<BR ALIGN="LEFT"/></I></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">~SimulationMemento(…)<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>konstruktor pakietowy – tworzy go tylko Simulation; kopiuje<BR ALIGN="LEFT"/>listy i generator<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">~getStepNumber(), ~getPersons(), ~getContacts(), ~getNextId(), ~getConfig()<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>dostęp pakietowy – tylko Simulation zagląda do środka<BR ALIGN="LEFT"/>(hermetyzacja)<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">~getRandom(): Random<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>zwraca nową kopię generatora – pamiątkę można przywrócić wiele<BR ALIGN="LEFT"/>razy<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">~copyOf(Random r): Random  {static}<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>głęboka kopia generatora przez serializację do bajtów<BR ALIGN="LEFT"/></I></FONT></TD></TR><HR/><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#FFF9C4"><FONT POINT-SIZE="10">Klasa Serializable – umożliwia zapis do pliku w dowolnym<BR ALIGN="LEFT"/>momencie t.<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
    PersonSnapshot [label=<<TABLE BORDER="2" COLOR="#E65100" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFE8CC"><TR><TD COLSPAN="2" BGCOLOR="#E65100" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><I>«record»</I><BR/><B>PersonSnapshot</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#607D8B">pole / metoda   ·   opis</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">id: int<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>numer osobnika<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">x, y: double<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>położenie [m]<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">vx, vy: double<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>składowe prędkości [m/s] – bez przeliczania na kąt, żeby<BR ALIGN="LEFT"/>odtworzenie było dokładne<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">stateType: StateType<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>typ stanu zdrowotnego<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">remainingSteps: int<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>pozostałe kroki choroby<BR ALIGN="LEFT"/></I></FONT></TD></TR><HR/><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#FFF9C4"><FONT POINT-SIZE="10">Niemutowalna kopia jednego osobnika.<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
    ContactEntry [label=<<TABLE BORDER="2" COLOR="#E65100" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFE8CC"><TR><TD COLSPAN="2" BGCOLOR="#E65100" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><I>«record»</I><BR/><B>ContactEntry</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#607D8B">pole / metoda   ·   opis</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">idA: int<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>numer pierwszego osobnika pary<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">idB: int<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>numer drugiego osobnika pary<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">steps: int<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>licznik kroków kontaktu<BR ALIGN="LEFT"/></I></FONT></TD></TR></TABLE>>];
    SimulationCareTaker [label=<<TABLE BORDER="2" COLOR="#E65100" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFE8CC"><TR><TD COLSPAN="2" BGCOLOR="#E65100" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><I>«CareTaker»</I><BR/><B>SimulationCareTaker</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#607D8B">pole / metoda   ·   opis</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">-originator: Simulation<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>symulacja, której migawki obsługuje<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-mementos: List&lt;SimulationMemento&gt;<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>historia migawek (nie zagląda do ich wnętrza)<BR ALIGN="LEFT"/></I></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">+create(): int<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>tworzy migawkę, dopisuje do historii i zwraca jej numer<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+restore(int number): void<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>przywraca symulację do migawki o podanym numerze<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+size(): int<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>liczba zapisanych migawek<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+saveToFile(Path path): void<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>zapisuje bieżący stan do pliku (serializacja Javy)<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+loadFromFile(Path path): void<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>wczytuje migawkę z pliku, dopisuje do historii i przywraca<BR ALIGN="LEFT"/>symulację<BR ALIGN="LEFT"/></I></FONT></TD></TR></TABLE>>];
  }

  subgraph cluster_ui {
    label=<<B>Wizualizacja i klient</B>>; labeljust="l"; fontsize=15; fontcolor="#6A1B9A";
    style="filled,rounded"; fillcolor="#F8F2FC"; color="#6A1B9A"; penwidth=2; margin=14;
    Main [label=<<TABLE BORDER="2" COLOR="#6A1B9A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EBDDF7"><TR><TD COLSPAN="2" BGCOLOR="#6A1B9A" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><I>«Client Application»</I><BR/><B>Main</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#607D8B">pole / metoda   ·   opis</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">+main(String[] args): void<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>otwiera okno MainWindow (w wątku Swing)<BR ALIGN="LEFT"/></I></FONT></TD></TR></TABLE>>];
    MainWindow [label=<<TABLE BORDER="2" COLOR="#6A1B9A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EBDDF7"><TR><TD COLSPAN="2" BGCOLOR="#6A1B9A" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><I>«JFrame»</I><BR/><B>MainWindow</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#607D8B">pole / metoda   ·   opis</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">-simulation: Simulation<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>bieżąca symulacja<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-careTaker: SimulationCareTaker<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>punkty zapisu bieżącej symulacji<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-panel: SimulationPanel<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>obszar rysowania<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-timer: javax.swing.Timer<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>co 40 ms (25 kroków/s) wywołuje tick()<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-stepsPerTick: int<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>przyspieszenie x1 / x2 / x5 / x10<BR ALIGN="LEFT"/></I></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">+MainWindow()<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>tworzy symulację (przypadek 2), CareTakera, panel i przyciski<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">~caseConfig(int number): SimulationConfig  {static}<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>przypadek 1: immuneRatio = 0, przypadek 2: 0,3<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-tick(): void<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>stepsPerTick × step(), potem odświeżenie widoku<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-toggleRunning(): void<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>przycisk Start / Pauza<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-startNewSimulation(int number): void<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>przyciski Przypadek 1 / Przypadek 2<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-saveCheckpoint() / -restoreCheckpoint()<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>careTaker.create() / careTaker.restore(n)<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-saveToFile() / -loadFromFile()<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>careTaker.saveToFile / loadFromFile, plik wybierany w<BR ALIGN="LEFT"/>JFileChooser<BR ALIGN="LEFT"/></I></FONT></TD></TR></TABLE>>];
    SimulationPanel [label=<<TABLE BORDER="2" COLOR="#6A1B9A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EBDDF7"><TR><TD COLSPAN="2" BGCOLOR="#6A1B9A" ALIGN="CENTER"><FONT COLOR="white" POINT-SIZE="13"><I>«JPanel»</I><BR/><B>SimulationPanel</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#607D8B">pole / metoda   ·   opis</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">-simulation: Simulation<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>rysowana symulacja<BR ALIGN="LEFT"/></I></FONT></TD></TR><HR/><TR><TD ALIGN="LEFT" VALIGN="TOP">+SimulationPanel(Simulation s)<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>tworzy panel 700 × 700 px<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">+setSimulation(Simulation s): void<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>podmiana symulacji po zmianie przypadku<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">#paintComponent(Graphics g): void<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>rysuje obszar i osobniki, skala metry → piksele, okrąg 2 m<BR ALIGN="LEFT"/>wokół zakażonych<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">~colorOf(HealthState s): Color  {static}<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>odporny niebieski, zdrowy zielony, bezobjawowy pomarańczowy,<BR ALIGN="LEFT"/>objawowy czerwony<BR ALIGN="LEFT"/></I></FONT></TD></TR><TR><TD ALIGN="LEFT" VALIGN="TOP">-drawLegend(Graphics2D g, int x, int y): void<BR ALIGN="LEFT"/></TD><TD ALIGN="LEFT" VALIGN="TOP"><FONT COLOR="#37474F" POINT-SIZE="10"><I>legenda kolorów<BR ALIGN="LEFT"/></I></FONT></TD></TR></TABLE>>];
  }

  Legenda [label=<<TABLE BORDER="1" COLOR="#90A4AE" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="2" ALIGN="LEFT"><B>Legenda</B></TD></TR><TR><TD BGCOLOR="#ECEFF1" WIDTH="22"> </TD><TD ALIGN="LEFT">wektory z Laboratorium 2</TD></TR><TR><TD BGCOLOR="#BBDEFB" WIDTH="22"> </TD><TD ALIGN="LEFT">wzorzec Stan</TD></TR><TR><TD BGCOLOR="#DFF3DF" WIDTH="22"> </TD><TD ALIGN="LEFT">model symulacji</TD></TR><TR><TD BGCOLOR="#FFE8CC" WIDTH="22"> </TD><TD ALIGN="LEFT">wzorzec Pamiątka</TD></TR><TR><TD BGCOLOR="#EBDDF7" WIDTH="22"> </TD><TD ALIGN="LEFT">wizualizacja i klient</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="10">▷ dziedziczenie / implementacja   ◆ kompozycja   ◇ agregacja<BR ALIGN="LEFT"/>→ asocjacja   ⇢ zależność   żółte pola – uwagi</FONT></TD></TR></TABLE>>];
  Vector2D -> IVector [style=dashed, arrowhead=onormal, fontname="DejaVu Sans", fontsize=10];
  Polar2DAdapter -> IVector [style=dashed, arrowhead=onormal, fontname="DejaVu Sans", fontsize=10];
  Polar2DAdapter -> IPolar2D [style=dashed, arrowhead=onormal, fontname="DejaVu Sans", fontsize=10];
  Polar2DAdapter -> Vector2D [dir=both, arrowtail=odiamond, arrowhead=vee, fontname="DejaVu Sans", fontsize=10, label=<<I>srcVector</I>>];
  ImmuneState -> HealthState [style=dashed, arrowhead=onormal, fontname="DejaVu Sans", fontsize=10];
  HealthyState -> HealthState [style=dashed, arrowhead=onormal, fontname="DejaVu Sans", fontsize=10];
  InfectedState -> HealthState [style=dashed, arrowhead=onormal, fontname="DejaVu Sans", fontsize=10];
  SymptomaticState -> InfectedState [arrowhead=onormal, fontname="DejaVu Sans", fontsize=10];
  AsymptomaticState -> InfectedState [arrowhead=onormal, fontname="DejaVu Sans", fontsize=10];
  HealthState -> StateType [style=dashed, arrowhead=vee, fontname="DejaVu Sans", fontsize=10];
  StateFactory -> HealthState [style=dashed, arrowhead=vee, fontname="DejaVu Sans", fontsize=10, label=<<I>«create»</I>>];
  Person -> HealthState [dir=both, arrowtail=odiamond, arrowhead=vee, fontname="DejaVu Sans", fontsize=10, label=<<I>state</I>>, headlabel="1"];
  Person -> Vector2D [dir=both, arrowtail=diamond, arrowhead=none, fontname="DejaVu Sans", fontsize=10, label=<<I>position</I>>];
  Person -> Polar2DAdapter [dir=both, arrowtail=diamond, arrowhead=none, fontname="DejaVu Sans", fontsize=10, label=<<I>velocity</I>>];
  Simulation -> Person [dir=both, arrowtail=diamond, arrowhead=none, fontname="DejaVu Sans", fontsize=10, headlabel="0..*"];
  Simulation -> Area [dir=both, arrowtail=diamond, arrowhead=none, fontname="DejaVu Sans", fontsize=10];
  Simulation -> ContactTracker [dir=both, arrowtail=diamond, arrowhead=none, fontname="DejaVu Sans", fontsize=10];
  Simulation -> SimulationConfig [arrowhead=vee, fontname="DejaVu Sans", fontsize=10];
  Simulation -> StateFactory [style=dashed, arrowhead=vee, fontname="DejaVu Sans", fontsize=10];
  ContactTracker -> Person [style=dashed, arrowhead=vee, fontname="DejaVu Sans", fontsize=10];
  ContactTracker -> ContactEntry [style=dashed, arrowhead=vee, fontname="DejaVu Sans", fontsize=10, label=<<I>«create»</I>>];
  Simulation -> SimulationMemento [style=dashed, arrowhead=vee, fontname="DejaVu Sans", fontsize=10, label=<<I>«create»</I>>];
  SimulationMemento -> PersonSnapshot [dir=both, arrowtail=diamond, arrowhead=none, fontname="DejaVu Sans", fontsize=10, headlabel="0..*"];
  SimulationMemento -> ContactEntry [dir=both, arrowtail=diamond, arrowhead=none, fontname="DejaVu Sans", fontsize=10, headlabel="0..*"];
  SimulationMemento -> SimulationConfig [arrowhead=vee, fontname="DejaVu Sans", fontsize=10];
  PersonSnapshot -> StateType [style=dashed, arrowhead=vee, fontname="DejaVu Sans", fontsize=10];
  SimulationCareTaker -> Simulation [dir=both, arrowtail=odiamond, arrowhead=vee, fontname="DejaVu Sans", fontsize=10, label=<<I>originator</I>>, headlabel="1"];
  SimulationCareTaker -> SimulationMemento [dir=both, arrowtail=odiamond, arrowhead=vee, fontname="DejaVu Sans", fontsize=10, label=<<I>mementos</I>>, headlabel="N"];
  Main -> MainWindow [arrowhead=vee, fontname="DejaVu Sans", fontsize=10];
  MainWindow -> Simulation [arrowhead=vee, fontname="DejaVu Sans", fontsize=10];
  MainWindow -> SimulationCareTaker [arrowhead=vee, fontname="DejaVu Sans", fontsize=10];
  MainWindow -> SimulationPanel [dir=both, arrowtail=diamond, arrowhead=none, fontname="DejaVu Sans", fontsize=10];
  SimulationPanel -> Simulation [style=dashed, arrowhead=vee, fontname="DejaVu Sans", fontsize=10, label=<<I>rysuje</I>>];
}
